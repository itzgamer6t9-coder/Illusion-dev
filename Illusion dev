-- // [6] FUNCTIONALITY //
local function setupFunctionality()
    OpenBtn.MouseButton1Click:Connect(function()
        MainFrame.Visible = not MainFrame.Visible
    end)

    UserInputService.InputBegan:Connect(function(input)
        if input.KeyCode == CONFIG.Keybinds.ToggleGUI then
            MainFrame.Visible = not MainFrame.Visible
        end
        if input.KeyCode == CONFIG.Keybinds.Speed then
            CONFIG.Values.Speed = CONFIG.Values.Speed + 5
            if Humanoid then Humanoid.WalkSpeed = CONFIG.Values.Speed end
        end
        -- Add more keybinds here easily
    end)

    -- Speed loop
    Connections.Speed = RunService.Heartbeat:Connect(function()
        if CONFIG.Toggles.SpeedHack and Humanoid then
            Humanoid.WalkSpeed = CONFIG.Values.Speed
        end
        if CONFIG.Toggles.Float and HRP then
            applyVelocity(Vector3.new(0, 5, 0))
        end
        if CONFIG.Toggles.Fling and HRP then
            applyVelocity(Vector3.new(math.random(-60, -50), 5, math.random(-15, 15)))
        end
    end)

    -- Anti-Ragdoll example
    if Humanoid then
        Humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
    end

    -- Plot scanner (example)
    print("[ULT PROTECTION] Welcome, " .. LocalPlayer.Name)
    for _, plot in ipairs(Workspace:FindFirstChild("Plots"):GetChildren()) do
        if plot:FindFirstChild("PlotSign") then
            print("Detected plot: " .. plot.Name)
        end
    end
end

